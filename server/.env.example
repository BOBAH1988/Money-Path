# Порт и адрес, на которых слушает API
PORT=8080
HOST=0.0.0.0

# Уровень логирования: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Postgres. Используется этапом 3 плана; пока необязателен.
DATABASE_URL=postgres://money_path:change_me@127.0.0.1:5432/money_path

# Отдельная база для интеграционных тестов (`npm test`). Без неё тесты БД пропускаются.
TEST_DATABASE_URL=postgres://money_path:change_me@127.0.0.1:5432/money_path_test

# Firebase (этап 4): проверка ID-token через firebase-admin.
# Учётные данные — только в .env на сервере или в GitHub Secrets, никогда в репозитории.
FIREBASE_PROJECT_ID=

# uid администраторов через запятую — доступ к /admin/stats. Пусто — эндпоинт закрыт.
ADMIN_UIDS=

# --- Периметр API ---

# Origin'ы приложения для браузера через запятую, например
# CORS_ORIGINS=https://bobah1988.github.io,http://localhost:5173
# Пусто — cross-origin запросы запрещены, браузер получит ошибку CORS.
CORS_ORIGINS=

# Лимит запросов: не больше RATE_LIMIT_MAX за RATE_LIMIT_WINDOW_MS на uid (или IP до входа).
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# Максимальный размер тела запроса в байтах. Аватар (data URL) укладывается в 256 КБ.
BODY_LIMIT=262144

# Кэш проверки токена: сколько миллисекунд доверять уже проверенному токену.
# 0 — проверять каждый запрос (задержка отзыва нулевая, но поход к Google на каждый вызов).
TOKEN_CACHE_TTL_MS=300000
TOKEN_CACHE_MAX=5000
