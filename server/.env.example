# Порт и адрес, на которых слушает API
PORT=8080
HOST=0.0.0.0

# Уровень логирования: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Postgres. Используется этапом 3 плана; пока необязателен.
DATABASE_URL=postgres://money_path:change_me@127.0.0.1:5432/money_path

# Firebase (этап 4): проверка ID-token через firebase-admin.
# Учётные данные — только в .env на сервере или в GitHub Secrets, никогда в репозитории.
FIREBASE_PROJECT_ID=
