rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email == '79042044926@ya.ru';
    }

    // Профиль/активность пользователя (trackUser). Пользователь пишет только свой документ; администратор может читать список.
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();

      // Данные приложения пользователя: только владелец (и администратор при необходимости отладки).
      match /{collection}/{document=**} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Корневые коллекции (гостевой/legacy режим без userId) — по умолчанию запрещены.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
