rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == '79042044926@ya.ru'
        && request.auth.token.email_verified == true;
    }

    // Аналитика администратора читает только список профилей, не пользовательские финансовые данные.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // Данные приложения доступны только владельцу аккаунта.
      match /{collection}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Legacy budget plan document; only the account owner can access its own path.
    match /budget_plan/users/{userId}/budget_plan {
      allow read, write: if isOwner(userId);
    }

    // Корневые коллекции (гостевой/legacy режим без userId) — по умолчанию запрещены.
    //
    // ВАЖНО: в Firestore Rules правила не каскадные и совпадающие allow объединяются
    // по «или», а не перекрываются. Этот запрет не закрывает users/{userId} и
    // budget_plan/users/{userId} выше — они остаются доступны своим владельцам.
    // Он нужен только для путей, которые не описаны явно. Не удаляйте его
    // «как дубликат»: без него таким путям останется неявный запрет по умолчанию,
    // но при добавлении новых match-блоков легко потерять контроль.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
