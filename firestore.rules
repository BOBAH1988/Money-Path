rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email == '79042044926@ya.ru';
    }

    // Аналитика администратора читает только список профилей, не пользовательские финансовые данные.
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isAdmin();
      allow create, update: if isOwner(userId);
      allow delete: if false;

      // Данные приложения доступны только владельцу аккаунта.
      match /{collection}/{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Корневые коллекции (гостевой/legacy режим без userId) — по умолчанию запрещены.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
